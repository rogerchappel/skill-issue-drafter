{
  "name": "skill-issue-drafter",
  "version": "0.1.0",
  "description": "Dry-run GitHub issue draft generator for agent findings.",
  "type": "module",
  "bin": {
    "skill-issue-drafter": "./bin/skill-issue-drafter.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/markdown.js && node --check bin/skill-issue-drafter.js && node --check test/index.test.js && bash -n scripts/package-smoke.sh",
    "smoke": "node bin/skill-issue-drafter.js examples/findings.json --out /tmp/skill-issue-drafter.md",
    "package:smoke": "bash scripts/package-smoke.sh",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agent",
    "github",
    "issues",
    "dry-run",
    "skill"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/skill-issue-drafter.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/skill-issue-drafter/issues"
  },
  "homepage": "https://github.com/rogerchappel/skill-issue-drafter#readme"
}
